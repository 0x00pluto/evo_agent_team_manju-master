# 独立运行用。在 https://www.dexbuddy.app 创建用户 Key（dbh_sk_ 开头）
# 不要放进插件设置，也不要打进 zip。装进 Dex Buddy 后对话走登录会话。
# 复制为本仓根目录 .env 后填写（.env 已 gitignore，勿提交）
DEX_BUDDY_API_KEY=
# DEX_GATEWAY_BASE_URL=https://www.dexbuddy.app

# 飞书文档读取：https://open.feishu.cn/app 创建自建应用
# 开通「查看新版文档」「查看知识库」，并把应用加进要读的文档或知识空间
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 配音：申请 https://platform.minimax.io/console/access
# 学新声仍见 docs/workflows/minimax-voice-clone-and-tts.md
MINIMAX_API_KEY=
