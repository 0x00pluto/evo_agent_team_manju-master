# 申请 https://platform.deepseek.com/api_keys
# 文档 https://api-docs.deepseek.com/zh-cn/
# 复制为本仓根目录 .env 后填写（.env 已 gitignore，勿提交）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 飞书文档读取：https://open.feishu.cn/app 创建自建应用
# 开通「查看新版文档」「查看知识库」，并把应用加进要读的文档或知识空间
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 配音：国际站 https://api.minimax.io 。学新声仍见 docs/workflows/minimax-voice-clone-and-tts.md
MINIMAX_API_KEY=
